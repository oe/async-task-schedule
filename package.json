{
  "name": "async-task-schedule",
  "version": "1.0.1",
  "description": "Batch and deduplicate async requests with TTL caching.",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "vite build",
    "benchmark": "npm run build && node scripts/benchmark.cjs",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "vitest run --coverage",
    "test:perf": "vitest run test/performance.spec.ts",
    "release": "yarn test && yarn build && yarn publish"
  },
  "keywords": [
    "batch",
    "batching",
    "deduplication",
    "request-deduplication",
    "coalescing",
    "promise",
    "async",
    "cache",
    "ttl",
    "typescript"
  ],
  "repository": "https://github.com/oe/async-task-schedule.git",
  "author": "Saiya <oklark@outlook.com>",
  "license": "MIT",
  "private": false,
  "source": "src/index.ts",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "2.1.5",
    "typescript": ">=3.0.0",
    "vite": "^5.4.11",
    "vitest": "^2.1.5",
    "vite-plugin-dts": "^4.3.0"
  },
  "homepage": "https://github.com/oe/async-task-schedule#readme",
  "bugs": {
    "url": "https://github.com/oe/async-task-schedule/issues"
  }
}
